{
  "name": "albrooks-price-action-journal",
  "version": "3.1.0",
  "description": "Al Brooks Price Action Trading Journal - Windows Desktop Application",
  "main": "main.js",
  "author": "Mahdi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mahdi.priceactionjournal",
    "productName": "Price Action Trading Journal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Price Action Trading Journal"
    }
  }
}